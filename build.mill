//| mill-version: 1.2.0-RC1-46-16168f

package build

import mill.*
import mill.scalalib.*
import mill.scalalib.publish.*
import mill.util.VcsVersion

object Versions {
  val mill = "1.2.0-RC1-46-16168f"
  val scala = "3.8.3"
  val zinc = "2.0.1"
  val utest = "0.9.1"
  val upickle = "4.4.3"
  val plugin = "1.0.0"
}

object Constants {
  val projectName = "mill-strict-deps"
  val githubUsername = "nguyenyou"
  val author = "Tu Nguyen"
  val organization = "io.github.nguyenyou"
  val repoUrl = s"https://github.com/$githubUsername/$projectName"
  val githubProfile = s"https://github.com/$githubUsername"
  val description = "Mill plugin for strict JVM dependency reports"
}

/**
 * Mill plugin that adds strict dependency reporting to JVM modules.
 *
 * Publish locally with `./mill strictdeps.publishLocal`.
 * Publish to Sonatype Central with `./mill strictdeps.publishSonatypeCentral`.
 */
object strictdeps extends ScalaModule with SonatypeCentralPublishModule {
  def scalaVersion = Versions.scala
  def artifactName = Constants.projectName
  def platformSuffix = "_mill1"

  def mvnDeps = Task {
    Seq(
      mvn"com.lihaoyi::mill-libs:${Versions.mill}",
      mvn"com.lihaoyi::upickle:${Versions.upickle}",
      mvn"org.scala-sbt::zinc:${Versions.zinc}"
    )
  }

  override protected def resolvedDepsWarnNonPlatform: T[Boolean] = Task {
    false
  }

  object test extends ScalaTests with TestModule.Utest {
    override def forkArgs = Task {
      super.forkArgs() ++ Seq(s"-Dmill.strictdeps.test.scalaVersion=${Versions.scala}")
    }

    def mvnDeps = Seq(
      mvn"com.lihaoyi::utest:${Versions.utest}",
      mvn"com.lihaoyi::mill-testkit:${Versions.mill}"
    )
  }

  def pomSettings = PomSettings(
    description = Constants.description,
    organization = Constants.organization,
    url = Constants.repoUrl,
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github(Constants.githubUsername, Constants.projectName),
    developers = Seq(
      Developer(Constants.githubUsername, Constants.author, Constants.githubProfile)
    )
  )

  def publishVersion = VcsVersion.vcsState().format(noTagFallback = Versions.plugin)
}
